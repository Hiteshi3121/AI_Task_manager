[Unit]
Description=Ishita HQ FastAPI Backend
After=network.target postgresql.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/ishitahq/backend
EnvironmentFile=/home/ubuntu/ishitahq/backend/.env
ExecStart=/home/ubuntu/ishitahq/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
